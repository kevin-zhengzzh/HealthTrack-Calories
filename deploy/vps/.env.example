# Copy to .env on the server and fill in. Never commit .env.

# Your domain, without https:// (an A record for it must point at this server)
DOMAIN=example.com

# Generate each with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_KEY=

# Optional: without them the app works and AI features say "unavailable"
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
