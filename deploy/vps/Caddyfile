# DOMAIN is the bare domain (e.g. kevinzheng.dev). Each app gets its own
# subdomain; the bare domain is kept for a portfolio site.

healthtrack.{$DOMAIN} {
	encode gzip

	# Photos are uploaded through the API; allow up to 10 MB per request.
	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Until the portfolio exists, the bare domain points to the app. Temporary
# (302) on purpose: browsers and search engines don't cache it, so the bare
# domain can be reused later.
{$DOMAIN}, www.{$DOMAIN} {
	redir https://healthtrack.{$DOMAIN}{uri} 302
}
