{$DOMAIN} {
	encode gzip

	# Photos are uploaded through the API; allow up to 10 MB per request.
	request_body {
		max_size 10MB
	}

	handle /api/* {
		reverse_proxy backend:5000
	}

	handle {
		reverse_proxy frontend:80
	}
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
